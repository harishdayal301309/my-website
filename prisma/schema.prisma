generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String   // up to 3000 chars
  link      String?
  mediaUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LinkHub {
  id        String   @id @default(cuid())
  title     String
  url       String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
